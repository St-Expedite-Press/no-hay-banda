# .env.example — New Showbiz Marketing Agent
#
# Copy this file to .env and fill in real values before running any service.
# NEVER commit .env to git. The .gitignore must exclude it.
# NEVER bake secrets into container images.
# All sensitive values are mounted via this file at runtime.

# ---------------------------------------------------------------------------
# AWS
# ---------------------------------------------------------------------------

AWS_ACCOUNT_ID="<12-digit-account-id>"
AWS_REGION="us-east-1"
AWS_DEFAULT_REGION="us-east-1"
AWS_ACCESS_KEY_ID="AKIA..."
AWS_SECRET_ACCESS_KEY="<aws-secret>"
AWS_SESSION_TOKEN=""

# ---------------------------------------------------------------------------
# AWS Console (optional — for human signin reference only, not used by agent)
# ---------------------------------------------------------------------------

AWS_CONSOLE_SIGNIN_URL="https://<account-id>.signin.aws.amazon.com/console"
AWS_CONSOLE_USERNAME="<iam-console-username>"
AWS_CONSOLE_PASSWORD="<iam-console-password>"
AWS_SIGN_IN_PASSWORD="<aws-signin-password>"

# ---------------------------------------------------------------------------
# OpenAI
# ---------------------------------------------------------------------------

# Used for Phase 0-1 draft generation.
# In Phase 2+, migrate to local vLLM; update MODEL_ENDPOINT_URL/MODEL_NAME in config.yaml instead.
OPENAI_API_KEY="sk-proj-..."

# ---------------------------------------------------------------------------
# OpenRouter
# ---------------------------------------------------------------------------

OPEN_ROUTER_API="sk-or-v1-..."

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------

# Use sk_test_... for development. sk_live_... is production — treat with extreme care.
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ---------------------------------------------------------------------------
# GitHub
# ---------------------------------------------------------------------------

GITHUB_PAT_WRITE="ghp_..."
GITHUB_REPO_URL=

# ---------------------------------------------------------------------------
# Hugging Face
# ---------------------------------------------------------------------------

HUGGINGFACE_WRITE="hf_..."

# ---------------------------------------------------------------------------
# Cloudflare
# ---------------------------------------------------------------------------


# ---------------------------------------------------------------------------
# Census
# ---------------------------------------------------------------------------

CENSUSDATA_KEY="<census-api-key>"

# ---------------------------------------------------------------------------
# X Ingestion — Scweet (Phase 1 read-only)
# ---------------------------------------------------------------------------

# Kill switch. Set to false to disable ALL X data ingestion immediately.
# A single env var must halt all reads — non-negotiable per customer spec.
INGEST_ENABLED=true

# auth_token cookie for the DEDICATED THROWAWAY read account only.
# WARNING: NEVER use the brand @new_show_biz account credentials here.
# The brand account is human-posting only and must never appear in scraping cookies.
SCWEET_AUTH_TOKEN=<throwaway-account-auth-token>

# ct0 cookie for the throwaway account (required for GraphQL endpoints).
SCWEET_CT0=<throwaway-account-ct0>

# Username of the dedicated throwaway read account (for audit logs).
SCWEET_ACCOUNT_USERNAME=<throwaway-account-username>

# ---------------------------------------------------------------------------
# Proxy Configuration (optional but recommended per Scweet guidance)
# ---------------------------------------------------------------------------

# Absolute path to a newline-delimited proxy list file.
# Leave blank to disable proxy rotation.
# Format per line: http://user:pass@host:port
PROXY_LIST_PATH=

# ---------------------------------------------------------------------------
# Draft Output
# ---------------------------------------------------------------------------

# Base directory for draft output. Drafts land in DRAFTS_BASE_DIR/YYYY-MM-DD/
# Defaults to ./drafts relative to repo root if not set.
DRAFTS_BASE_DIR=./drafts

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# Directory for structured JSON-lines logs (trace IDs link source → prompt → draft).
LOG_DIR=./logs

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Phase 2+ (local vLLM) — fill in when migrating away from OpenAI
# ---------------------------------------------------------------------------

# These override config.yaml model settings when set. Leave blank in Phase 1.
MODEL_ENDPOINT_URL=
MODEL_NAME=
