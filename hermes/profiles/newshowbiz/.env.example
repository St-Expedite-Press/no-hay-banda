# New Showbiz operator — profile env
# Copy to ~/.hermes/profiles/newshowbiz/.env and populate with real values.
# Keep local. Never commit. Never paste values into docs, prompts, or reports.

# X integration kill switch — set to false to halt all X reads immediately
INGEST_ENABLED=false

# X credentials — the operator X account
TWITTER_USERNAME=your_x_username
TWITTER_PASSWORD=your_x_password

# Session persistence directory for Barresider x-mcp
# Must match the x-auth/ path inside the profile directory
X_AUTH_DIR=/home/ec2-user/.hermes/profiles/newshowbiz/x-auth

# Model provider
# Get a key at openrouter.ai — the profile config uses deepseek/deepseek-v4-pro
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Hermes profile identifier
HERMES_PROFILE=newshowbiz

# Telegram oversight gate (Phase 3)
# Create bot via @BotFather. Chat ID: start the bot, send a message,
# then GET https://api.telegram.org/bot{TOKEN}/getUpdates to find your chat_id.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# Logging
LOG_LEVEL=INFO
LOG_DIR=/home/ec2-user/.hermes/profiles/newshowbiz/logs
