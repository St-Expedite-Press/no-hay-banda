# Global Hermes env — ~/.hermes/.env
# Keep local. Never commit.

# OpenRouter API key (primary model provider)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# GitHub PAT for the github MCP server (repo operations)
# Must have repo scope. Belongs to the org member account.
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your-pat-here

# Used by deploy scripts — format: https://{user}:{pat}@github.com/{org}/{repo}.git
GITHUB_PAT_WRITE=your-pat-here
