[Unit]
Description=New Showbiz — rotate session archive and compress pipeline logs

[Service]
Type=oneshot
ExecStart=/home/ec2-user/.hermes/profiles/newshowbiz/bin/rotate-logs.sh
StandardOutput=append:/home/ec2-user/.hermes/profiles/newshowbiz/logs/cron.log
StandardError=append:/home/ec2-user/.hermes/profiles/newshowbiz/logs/cron.log
