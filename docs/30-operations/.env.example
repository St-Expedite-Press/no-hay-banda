# .env.example - New Showbiz operator
#
# Copy this template to a local .env file for implementation work.
# Do not commit .env. Do not paste real values into documentation, prompts, issues,
# reports, screenshots, or agent context.

# ---------------------------------------------------------------------------
# AWS - optional deployment or infrastructure account
# ---------------------------------------------------------------------------
AWS_ACCOUNT_ID="<aws-account-id>"
AWS_REGION="<aws-region>"
AWS_DEFAULT_REGION="<aws-default-region>"
AWS_ACCESS_KEY_ID="<aws-access-key-id>"
AWS_SECRET_ACCESS_KEY="<aws-secret-access-key>"
AWS_SESSION_TOKEN="<aws-session-token-or-empty>"

# Optional human console reference only. Agents must not use console passwords.
AWS_CONSOLE_SIGNIN_URL="<aws-console-signin-url>"
AWS_CONSOLE_USERNAME="<aws-console-username>"
AWS_CONSOLE_PASSWORD="<aws-console-password>"
AWS_SIGN_IN_PASSWORD="<aws-sign-in-password>"

# ---------------------------------------------------------------------------
# Model providers
# ---------------------------------------------------------------------------
OPENAI_API_KEY="<openai-api-key>"
OPEN_ROUTER_API="<openrouter-api-key>"

# Phase 2+ local or remote compatible endpoint.
MODEL_ENDPOINT_URL="<model-endpoint-url-or-empty>"
MODEL_NAME="<model-name-or-empty>"

# ---------------------------------------------------------------------------
# Stripe - future donation/support metrics integration
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY="<stripe-secret-key>"
STRIPE_WEBHOOK_SECRET="<stripe-webhook-secret>"

# ---------------------------------------------------------------------------
# GitHub - optional automation only
# ---------------------------------------------------------------------------
GITHUB_PAT_WRITE="<github-write-token>"
GITHUB_REPO_URL="<github-repo-url>"

# ---------------------------------------------------------------------------
# Hugging Face - optional model operations
# ---------------------------------------------------------------------------
HUGGINGFACE_WRITE="<hugging-face-write-token>"

# ---------------------------------------------------------------------------
# Census - optional research
# ---------------------------------------------------------------------------
CENSUSDATA_KEY="<census-api-key>"

# ---------------------------------------------------------------------------
# X ingestion - Scweet, Phase 1 read-only
# ---------------------------------------------------------------------------
INGEST_ENABLED="false"
SCWEET_AUTH_TOKEN="<throwaway-x-read-account-auth-token>"
SCWEET_CT0="<throwaway-x-read-account-ct0-cookie>"
SCWEET_ACCOUNT_USERNAME="<throwaway-x-read-account-username>"
PROXY_LIST_PATH="<absolute-proxy-list-path-or-empty>"

# ---------------------------------------------------------------------------
# Draft output and logs
# ---------------------------------------------------------------------------
DRAFTS_BASE_DIR="./drafts"
LOG_DIR="./logs"
LOG_LEVEL="INFO"

# ---------------------------------------------------------------------------
# Hermes runtime
# ---------------------------------------------------------------------------
HERMES_PROFILE="newshowbiz"
HERMES_ENABLE_PROJECT_PLUGINS="false"

# ---------------------------------------------------------------------------
# Telegram oversight gateway
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN="<telegram-bot-token>"
TELEGRAM_ALLOWED_CHAT_IDS="<comma-separated-allowed-chat-ids>"
NEWSHOWBIZ_ALLOWED_CHAT_IDS="<comma-separated-allowed-chat-ids>"
